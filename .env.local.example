# Copy this file to .env.local and fill in real values.
# .env.local is gitignored.

# App Store Connect API credentials (used by scripts/release-ios.sh).
# Get them from: https://appstoreconnect.apple.com/access/integrations/api
# Also place the .p8 key at ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8
APPSTORE_KEY_ID=
APPSTORE_ISSUER_ID=

# Deployed environment values (read from CFN outputs after deploy).
# Vite uses the API URL for its cloud proxy; the local read-only API uses the key.
BATON_API_URL=
BATON_API_KEY=

# Optional, development only. Start server/dev-home-api.py before enabling.
# Only /api/bridge/project-sessions is routed here; all other APIs stay on the cloud.
# BATON_HOME_API_TARGET=http://127.0.0.1:8081
